### Delete rule data from&to || entryId
@baseUrl = http://localhost:3000/api/logger
@logId = cmricgvrc0001eb8z2oy98b9y
@sessionToken = 4ab33da4-2d0c-48b1-8c25-c75867fb40f9
### With from&to
DELETE {{baseUrl}}/logsdelete/{{logId}}
Content-Type: application/json
Cookie: datalink_session_token={{sessionToken}}

{
  "from":"2026-07-14T21:57:11.053Z",
  "to":"2026-07-14T22:20:19.326Z"
}
### with entryId
DELETE {{baseUrl}}/logsdelete/{{logId}}
Content-Type: application/json
Cookie: datalink_session_token={{sessionToken}}

{
  "entryId":"5007"
}

### Get all rules
GET http://localhost:3000/api/logger
Content-Type: : application/json

### Get data for specific rule
GET http://localhost:3000/api/logger/machine/log/MF1/cmrcknuhm000l4z8ze5ue0acw
Content-Type: : application/json




