{
  "name": "datalink-server",
  "private": true,
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx --bun prisma db push",
    "db:studio": "bun --bun prisma studio",
    "db:generate": "bunx --bun prisma generate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "@types/nodes7": "^0.3.4",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@datalink/shared": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "hono": "^4.12.25",
    "http-status-codes": "^2.3.0",
    "ldapts": "^8.1.8",
    "nodes7": "^0.3.18",
    "zod": "^4.4.3"
  }
}
